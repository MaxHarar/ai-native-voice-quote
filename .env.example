# Server (Railway)
TOOL_SECRET=            # >=24 chars; ElevenLabs sends it as x-tool-secret (stored as a workspace secret)
ADMIN_SECRET=           # eval oracle read access (/admin/quotes)
LICENSE_HMAC_KEY=       # HMAC key for license numbers (the full number is never stored)
OPS_USER=               # Basic-auth user for /ops and /q (ops console + quote summaries)
OPS_PASSWORD=           # Basic-auth password
DATABASE_PATH=/data/quotes.sqlite
BRAND_NAME="AI-Native Auto Insurance"
ELEVENLABS_AGENT_ID=    # optional: enables transcript links in /ops

# Agent deploy (local)
ELEVENLABS_API_KEY=
SERVER_URL=             # public https URL of the server
TRANSFER_NUMBER=        # E.164 (+1 then 10 digits). Hand-off destination; never commit a real number
AGENT_LLM=claude-haiku-5-5

# Telephony (iteration 2)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
